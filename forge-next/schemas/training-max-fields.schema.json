{
  "type": "array",
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "athleteId", "exerciseId", "unit"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 100 },
      "label": { "type": "string", "minLength": 1, "maxLength": 300 },
      "athleteId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
      "exerciseId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
      "unit": { "enum": ["kg", "lb"] },
      "value": { "type": "number", "exclusiveMinimum": 0 }
    }
  }
}
